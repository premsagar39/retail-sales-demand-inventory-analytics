            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/dates.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"date\", type datetime}, {\"year\", Int64.Type}, {\"month\", type text}, {\"weekday\", Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
