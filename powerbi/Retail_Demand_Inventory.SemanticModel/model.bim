{
  "name": "Retail_Demand_Inventory",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "DataRoot",
        "kind": "m",
        "expression": "\"C:/Data/retail-sales-demand-inventory-analytics/data/\" meta [IsParameterQuery=true,Type=\"Text\",IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "id",
            "dataType": "int64",
            "sourceColumn": "id",
            "summarizeBy": "sum"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "store_nbr",
            "dataType": "int64",
            "sourceColumn": "store_nbr",
            "summarizeBy": "sum"
          },
          {
            "name": "family",
            "dataType": "string",
            "sourceColumn": "family",
            "summarizeBy": "none"
          },
          {
            "name": "sales",
            "dataType": "double",
            "sourceColumn": "sales",
            "summarizeBy": "sum"
          },
          {
            "name": "onpromotion",
            "dataType": "double",
            "sourceColumn": "onpromotion",
            "summarizeBy": "sum"
          },
          {
            "name": "PromotionGroup",
            "dataType": "string",
            "sourceColumn": "PromotionGroup",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/sales.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"id\", Int64.Type}, {\"date\", type datetime}, {\"store_nbr\", Int64.Type}, {\"family\", type text}, {\"sales\", type number}, {\"onpromotion\", type number}},\"en-US\"),",
                " Final = Table.AddColumn(Typed,\"PromotionGroup\",each if [onpromotion]>0 then \"Promoted\" else \"Not promoted\",type text)",
                "in Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Recorded Sales",
            "expression": "SUM(Sales[sales])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Sales Rows",
            "expression": "COUNTROWS(Sales)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Stores Observed",
            "expression": "DISTINCTCOUNT(Sales[store_nbr])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Families Observed",
            "expression": "DISTINCTCOUNT(Sales[family])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Observed Sales Days",
            "expression": "DISTINCTCOUNT(Sales[date])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Sales per Observed Day",
            "expression": "DIVIDE([Recorded Sales],[Observed Sales Days])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Promotion Items",
            "expression": "SUM(Sales[onpromotion])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Promoted Row Share",
            "expression": "DIVIDE(CALCULATE([Sales Rows],Sales[onpromotion]>0),[Sales Rows])",
            "formatString": "0.0%",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Zero Recorded Sales Share",
            "expression": "DIVIDE(CALCULATE([Sales Rows],Sales[sales]=0),[Sales Rows])",
            "formatString": "0.0%",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Store Transactions",
            "expression": "SUM(Transactions[transactions])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Selected Forecast Model",
            "expression": "MAX(Selection[SelectedModel])",
            "formatString": "",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Holdout Actual",
            "expression": "VAR M=[Selected Forecast Model] RETURN CALCULATE(SUM(Forecasts[sales]),Forecasts[fold]=3,Forecasts[method]=M)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Holdout Forecast",
            "expression": "VAR M=[Selected Forecast Model] RETURN CALCULATE(SUM(Forecasts[prediction]),Forecasts[fold]=3,Forecasts[method]=M)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Holdout Absolute Error",
            "expression": "VAR M=[Selected Forecast Model] RETURN CALCULATE(SUMX(Forecasts,ABS(Forecasts[sales]-Forecasts[prediction])),Forecasts[fold]=3,Forecasts[method]=M)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Holdout WAPE",
            "expression": "DIVIDE([Holdout Absolute Error],[Holdout Actual])",
            "formatString": "0.00%",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Holdout Macro Family WAPE",
            "expression": "AVERAGEX(VALUES(Families[family]),[Holdout WAPE])",
            "formatString": "0.00%",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Holdout MAE",
            "expression": "VAR M=[Selected Forecast Model] RETURN DIVIDE([Holdout Absolute Error],CALCULATE(COUNTROWS(Forecasts),Forecasts[fold]=3,Forecasts[method]=M))",
            "formatString": "#,0.00",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Model WAPE Full Portfolio",
            "expression": "CALCULATE(MAX(Scores[WAPE]),Scores[fold]=3)",
            "formatString": "0.00%",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Future Forecast",
            "expression": "SUM(Future[prediction])",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Scenario Z",
            "expression": "SELECTEDVALUE(Inventory[service_z],1.65)",
            "formatString": "0.00",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Scenario Fill Rate",
            "expression": "VAR Z=[Scenario Z] RETURN DIVIDE(CALCULATE(SUM(Inventory[fulfilled]),Inventory[service_z]=Z),CALCULATE(SUM(Inventory[demand]),Inventory[service_z]=Z))",
            "formatString": "0.00%",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Scenario Lost Sales",
            "expression": "VAR Z=[Scenario Z] RETURN CALCULATE(SUM(Inventory[lost_sales_units]),Inventory[service_z]=Z)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Scenario Mean Stock",
            "expression": "VAR Z=[Scenario Z] RETURN CALCULATE(AVERAGE(Inventory[ending_stock]),Inventory[service_z]=Z)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          },
          {
            "name": "Assumed Holding Cost",
            "expression": "VAR Z=[Scenario Z] RETURN CALCULATE(SUM(Inventory[holding_cost_assumed]),Inventory[service_z]=Z)",
            "formatString": "#,0",
            "displayFolder": "Demand Analytics",
            "description": "See MEASURE_DEFINITIONS.md for denominator, scope and limitations."
          }
        ]
      },
      {
        "name": "Stores",
        "columns": [
          {
            "name": "store_nbr",
            "dataType": "int64",
            "sourceColumn": "store_nbr",
            "summarizeBy": "sum"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "state",
