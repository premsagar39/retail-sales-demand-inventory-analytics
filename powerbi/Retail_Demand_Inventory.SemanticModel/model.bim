                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"date\", type datetime}, {\"family\", type text}, {\"prediction\", type number}, {\"sales\", type number}, {\"method\", type text}, {\"fold\", Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
