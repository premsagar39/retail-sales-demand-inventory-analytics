          },
          {
            "name": "cluster",
            "dataType": "int64",
            "sourceColumn": "cluster",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Stores",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/stores.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"store_nbr\", Int64.Type}, {\"city\", type text}, {\"state\", type text}, {\"type\", type text}, {\"cluster\", Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Families",
        "columns": [
          {
            "name": "family",
            "dataType": "string",
            "sourceColumn": "family",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Families",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/families.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"family\", type text}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Dates",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
